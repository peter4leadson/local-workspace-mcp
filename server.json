{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.peter4leadson/local-workspace-mcp",
  "description": "Bounded, read-oriented filesystem, git and named-task tools over authorized workspace roots.",
  "version": "0.2.2",
  "repository": {
    "url": "https://github.com/peter4leadson/local-workspace-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/peter4leadson/local-workspace-mcp/v0.2.0/assets/local-workspace-mcp-icon-512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    },
    {
      "src": "https://raw.githubusercontent.com/peter4leadson/local-workspace-mcp/v0.2.0/assets/local-workspace-mcp-icon-128.png",
      "mimeType": "image/png",
      "sizes": ["128x128"]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "local-workspace-mcp",
      "version": "0.2.2",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx"
    }
  ]
}
